{
  "sourceLanguage": "en",
  "strings": {
    "%@ connected": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ подключён"
          }
        }
      }
    },
    "%@ is not running. Start the call or choose “All system audio”.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ не запущен. Начните созвон или выберите «Весь звук системы»."
          }
        }
      }
    },
    "API key": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ключ API"
          }
        }
      }
    },
    "About": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "О приложении"
          }
        }
      }
    },
    "Account": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Аккаунт"
          }
        }
      }
    },
    "Account default": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "По умолчанию для аккаунта"
          }
        }
      }
    },
    "Add an API key in Settings.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавьте ключ API в Настройках."
          }
        }
      }
    },
    "Agenda, project facts, numbers, things not to forget. They make hints more accurate.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Повестка, факты о проекте, цифры, о чём не забыть. С ними подсказки точнее."
          }
        }
      }
    },
    "All system audio": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Весь звук системы"
          }
        }
      }
    },
    "Allowed": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешено"
          }
        }
      }
    },
    "Answer style": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Стиль ответа"
          }
        }
      }
    },
    "Answer to a question": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ответ на вопрос"
          }
        }
      }
    },
    "Ask (⌃⌥Space)": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Спросить (⌃⌥Пробел)"
          }
        }
      }
    },
    "Ask anything, or take a screenshot and I’ll look at it.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Спроси что угодно или сделай снимок экрана — я посмотрю, что на нём."
          }
        }
      }
    },
    "Ask anything…": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Спроси что-нибудь…"
          }
        }
      }
    },
    "Assistant": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Помощник"
          }
        }
      }
    },
    "Audio level: %@": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уровень звука: %@"
          }
        }
      }
    },
    "Brief": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кратко"
          }
        }
      }
    },
    "Capture the main display without the Siri+ window. macOS will ask for permission.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Снять основной экран без окна Siri+. macOS запросит разрешение."
          }
        }
      }
    },
    "Capturing…": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Снимаю…"
          }
        }
      }
    },
    "ChatGPT sign-in could not be verified. Try again.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось подтвердить вход в ChatGPT. Попробуйте ещё раз."
          }
        }
      }
    },
    "ChatGPT sign-in failed (%lld).": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вход в ChatGPT не удался (%lld)."
          }
        }
      }
    },
    "ChatGPT sign-in returned incomplete tokens.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вход в ChatGPT вернул неполные данные."
          }
        }
      }
    },
    "ChatGPT sign-in timed out.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Время ожидания входа в ChatGPT истекло."
          }
        }
      }
    },
    "Check Again": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверить снова"
          }
        }
      }
    },
    "Choose a ChatGPT model in Settings.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите модель ChatGPT в Настройках."
          }
        }
      }
    },
    "Choose the call app and click Start. Headphones work best: then your microphone doesn’t repeat the other side.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите приложение созвона и нажмите «Начать». Лучше в наушниках: так микрофон не повторяет собеседника."
          }
        }
      }
    },
    "Claude Code": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code"
          }
        }
      }
    },
    "Claude Code could not complete the request.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code не смог выполнить запрос."
          }
        }
      }
    },
    "Claude Code is not installed. Install it from code.claude.com, then sign in in Settings.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code не установлен. Установите его с code.claude.com и войдите в Настройках."
          }
        }
      }
    },
    "Claude Haiku 5.5 — fastest and cheapest": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Haiku 5.5 — самый быстрый и дешёвый"
          }
        }
      }
    },
    "Claude Opus 5.5 — most accurate": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Opus 5.5 — точнее всех"
          }
        }
      }
    },
    "Claude Sonnet 5.5 — faster": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Sonnet 5.5 — быстрее"
          }
        }
      }
    },
    "Claude account sign-in works through the official Claude Code app. Install it, then click Sign In.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вход в аккаунт Claude работает через официальное приложение Claude Code. Установите его и нажмите «Войти»."
          }
        }
      }
    },
    "Clear": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Очистить"
          }
        }
      }
    },
    "Conversation": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Диалог"
          }
        }
      }
    },
    "Conversation history and screenshots are not saved to disk.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "История диалога и снимки не сохраняются на диск."
          }
        }
      }
    },
    "Copy": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скопировать"
          }
        }
      }
    },
    "Copy the transcript": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скопировать расшифровку"
          }
        }
      }
    },
    "Could not load the list of ChatGPT models.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось загрузить список моделей ChatGPT."
          }
        }
      }
    },
    "Could not open Terminal.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось открыть Терминал."
          }
        }
      }
    },
    "Could not open the browser.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось открыть браузер."
          }
        }
      }
    },
    "Could not read the model's response.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось прочитать ответ модели."
          }
        }
      }
    },
    "Default (GPT-6.1 Sol)": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "По умолчанию (GPT-6.1 Sol)"
          }
        }
      }
    },
    "Delete Key": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалить ключ"
          }
        }
