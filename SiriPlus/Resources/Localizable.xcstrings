    "Detailed": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подробно"
          }
        }
      }
    },
    "Dismiss the error": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Закрыть сообщение об ошибке"
          }
        }
      }
    },
    "Explain what’s on the screen": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Объясни, что на экране"
          }
        }
      }
    },
    "GPT-6 Astra — most capable": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "GPT-6 Astra — самая мощная"
          }
        }
      }
    },
    "GPT-6 Luna — fastest and cheapest": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "GPT-6 Luna — самая быстрая и дешёвая"
          }
        }
      }
    },
    "GPT-6.1 Sol — balanced": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "GPT-6.1 Sol — сбалансированная"
          }
        }
      }
    },
    "Get an API key": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Получить ключ API"
          }
        }
      }
    },
    "Help me with a question": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Помоги с вопросом"
          }
        }
      }
    },
    "Hide (Esc)": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скрыть (Esc)"
          }
        }
      }
    },
    "Hint Now": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подсказать"
          }
        }
      }
    },
    "Hint Now (⌃⌥Space)": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подсказать сейчас (⌃⌥Пробел)"
          }
        }
      }
    },
    "Hints": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подсказки"
          }
        }
      }
    },
    "Install Claude Code": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Установить Claude Code"
          }
        }
      }
    },
    "It will be sent with your next message.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уйдёт вместе со следующим сообщением."
          }
        }
      }
    },
    "I’ll suggest an answer when the other side asks a question.\n⌃⌥Space — hint now.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подскажу, когда собеседник задаст вопрос.\n⌃⌥Пробел — подсказать сейчас."
          }
        }
      }
    },
    "Keychain: %@.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Связка ключей: %@."
          }
        }
      }
    },
    "Let the participants know you use an assistant.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Предупредите участников, что используете помощника."
          }
        }
      }
    },
    "Listening stopped: %@": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запись остановлена: %@"
          }
        }
      }
    },
    "Listening to the meeting": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Слушаю созвон"
          }
        }
      }
    },
    "Listening… Text appears when someone speaks.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Слушаю… Текст появится, когда кто-нибудь заговорит."
          }
        }
      }
    },
    "Me": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Я"
          }
        }
      }
    },
    "Meeting": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Созвон"
          }
        }
      }
    },
    "Meeting in progress": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Идёт созвон"
          }
        }
      }
    },
    "Meeting notes": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Материалы к встрече"
          }
        }
      }
    },
    "Microphone": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Микрофон"
          }
        }
      }
    },
    "Model": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Модель"
          }
        }
      }
    },
    "Needed for screenshots and for meeting audio. After granting it you may need to restart the app.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нужна для снимков экрана и звука созвона. После выдачи разрешения может потребоваться перезапуск."
          }
        }
      }
    },
    "New Conversation": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Новый диалог"
          }
        }
      }
    },
    "No answer: %@": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ответ не получен: %@"
          }
        }
      }
    },
    "No display is available. Connect a display and take the screenshot again.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не найден доступный экран. Подключите дисплей и повторите снимок."
          }
        }
      }
    },
    "No display was found for audio capture.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не найден экран для захвата звука."
          }
        }
      }
    },
    "No microphone access. Allow it in System Settings → Privacy & Security → Microphone, or turn off your voice in Siri+ Settings.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет доступа к микрофону. Разрешите его в Системных настройках → Конфиденциальность и безопасность → Микрофон или отключите свой голос в Настройках Siri+."
          }
        }
      }
    },
    "No screenshot. Check Screen Recording access in macOS settings and try again. %@": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Снимок не получен. Проверьте доступ к записи экрана в настройках macOS и повторите. %@"
          }
        }
      }
    },
    "Not installed": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не установлен"
          }
        }
      }
    },
    "On questions and topic": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На вопросы и по теме"
          }
        }
      }
    },
    "On questions only": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Только на вопросы"
          }
        }
      }
    },
    "On request": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "По запросу"
          }
        }
      }
    },
    "On the topic": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "По теме"
          }
        }
      }
    },
    "On-device speech recognition for %@ is not available on this Mac. Choose another language in Settings.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Локальное распознавание для %@ недоступно на этом Mac. Выберите другой язык в Настройках."
          }
        }
      }
    },
    "Only when asked": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Только по запросу"
          }
        }
      }
    },
    "Only your messages, a screenshot you take, and the latest part of the meeting transcript (when a hint is needed) go to the cloud.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В облако уходят только ваши сообщения, снимок экрана по кнопке и последний фрагмент расшифровки созвона, когда нужна подсказка."
          }
        }
      }
    },
    "Open Assistant": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открыть помощника"
          }
        }
      }
    },
    "Open Microphone Settings": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открыть настройки микрофона"
          }
        }
      }
    },
    "Open Screen Recording Settings": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открыть настройки записи экрана"
          }
        }
      }
    },
    "Open Siri+": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открыть Siri+"
          }
        }
      }
    },
    "Open System Settings → Privacy & Security → %@.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откройте Системные настройки → Конфиденциальность и безопасность → %@."
          }
        }
      }
    },
    "Open the Siri+ window": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открыть окно Siri+"
          }
        }
      }
    },
    "Opens the Siri+ app.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открывает приложение Siri+."
          }
        }
      }
    },
    "Panel": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Панель"
          }
        }
      }
    },
    "Permission required": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Требуется разрешение"
          }
        }
      }
    },
    "Personal assistant": {
      "localizations": {
        "ru": {
